<Window x:Class="JellyfinMusic.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Jellyfin Music" Width="1280" Height="860" MinWidth="960" MinHeight="680" Background="#111519" Foreground="#EDF0EC" FontFamily="Yu Gothic UI, Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#C7E5A4"/>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#EDF0EC"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#20282C" BorderBrush="#394448" BorderThickness="1" CornerRadius="6" Padding="12"><TextBlock Text="⌄" HorizontalAlignment="Right" Foreground="#C7E5A4"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
    <TextBlock Text="{Binding SelectedItem.Name,RelativeSource={RelativeSource TemplatedParent}}" TextTrimming="CharacterEllipsis" Margin="12,10,30,10" VerticalAlignment="Center" IsHitTestVisible="False"/>
    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="#20282C" BorderBrush="#45534B" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="280"><ItemsPresenter/></ScrollViewer></Border></Popup>
   </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#EDF0EC"/><Setter Property="Padding" Value="12,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="#20282C"><TextBlock Text="{Binding Content.Name,RelativeSource={RelativeSource TemplatedParent}}" TextTrimming="CharacterEllipsis"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#394A3D"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#303D33"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="#161D20"><Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#52615B" CornerRadius="4" Margin="2,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#E9EDE8"/><Setter Property="Background" Value="#252D31"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#C7E5A4"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#20282C"/><Setter Property="Foreground" Value="#F4F5F1"/><Setter Property="CaretBrush" Value="#C7E5A4"/><Setter Property="BorderBrush" Value="#394448"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="14"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/><Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="0"/></Style>
 </Window.Resources>
 <Grid Background="#111519" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" UseLayoutRounding="True">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="104"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#111519">
   <StackPanel Margin="10,20,10,0" VerticalAlignment="Top">
    <Button x:Name="AlbumsNav" Style="{StaticResource Nav}" Click="Albums_Click"/>
    <Button x:Name="FavoritesNav" Style="{StaticResource Nav}" Click="Favorites_Click"/>
    <Button x:Name="QueueNav" Style="{StaticResource Nav}" Click="Queue_Click"/>
    <Border Height="1" Background="#293135" Margin="10,8"/>
    <Button x:Name="SettingsNav" Style="{StaticResource Nav}" Click="Settings_Click"/>
    <Border Width="8" Height="8" CornerRadius="4" Background="{Binding Foreground, ElementName=ConnectionStatus}" Margin="0,12,0,0" HorizontalAlignment="Center" Focusable="True" AutomationProperties.Name="接続状態">
     <Border.ToolTip><ToolTip><StackPanel><TextBlock x:Name="ConnectionStatus" Text="未接続" Foreground="#9BA9A1"/><TextBlock x:Name="ConnectionDetail" Text="設定から接続" Margin="0,4,0,0"/></StackPanel></ToolTip></Border.ToolTip>
    </Border>
   </StackPanel>
  </Border>
  <Grid Grid.Column="1" Margin="16,20,24,12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><ComboBox x:Name="LibrarySelector" MaxWidth="350" Margin="0,0,18,0" HorizontalAlignment="Left" VerticalAlignment="Center" MinWidth="220" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Library_Changed" AutomationProperties.Name="音楽ライブラリ"/><Grid Grid.Column="1" VerticalAlignment="Center"><TextBox x:Name="Search" ToolTip="アルバム名・アーティスト名を検索" AutomationProperties.Name="ライブラリ検索" TextChanged="Search_Changed"/><TextBlock Text="アルバムを検索" Margin="13,0" VerticalAlignment="Center" Foreground="#8D9B96" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Grid>
   <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="Heading" Text="アルバム" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="Subtitle" Foreground="#98A4A5" Margin="0,7,0,0"/></StackPanel><Button x:Name="Back" Grid.Column="1" Content="← 戻る" Click="Back_Click" IsEnabled="False" VerticalAlignment="Center"/></Grid>
   <ContentControl x:Name="AlbumHost" Grid.Row="2" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/><ScrollViewer x:Name="PageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0"><StackPanel x:Name="Page"/></ScrollViewer>
   <TextBlock Grid.Row="3" x:Name="Notice" Foreground="#A7B6AD" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Text="設定からJellyfinに接続してください。"/>
  </Grid>
  <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#1C2426" BorderBrush="#37433C" BorderThickness="0,1,0,0">
   <Grid Margin="20,10"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border x:Name="NowArt" Width="58" Height="58" Background="#354B45" CornerRadius="8"><TextBlock Text="♪" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center" Margin="14,0,0,0" Width="195"><TextBlock x:Name="NowTitle" Text="曲を選んでください" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="NowArtist" Text="アルバムから再生できます" Foreground="#9FAEAA" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></StackPanel>
    <StackPanel Grid.Column="1" Margin="18,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="ShuffleButton" Content="⇄" ToolTip="シャッフル" AutomationProperties.Name="シャッフル" Click="Shuffle_Click" Background="Transparent" Padding="12,7"/><Button x:Name="PrevButton" Content="|◀" AutomationProperties.Name="前の曲" Click="Previous_Click" Background="Transparent" Padding="12,7"/><Button x:Name="PlayButton" Content="▶" AutomationProperties.Name="再生・一時停止" Click="Play_Click" Background="#C7E5A4" Foreground="#17251B" Width="48" Height="38" Padding="0"/><Button x:Name="NextButton" Content="▶|" AutomationProperties.Name="次の曲" Click="Next_Click" Background="Transparent" Padding="12,7"/><Button x:Name="AlbumLoopButton" Content="アルバム ↻" ToolTip="アルバムループ" AutomationProperties.Name="アルバムループ" Click="AlbumLoop_Click" Background="Transparent" Padding="8,7" FontSize="11"/><Button x:Name="TrackLoopButton" Content="1曲 ↻" ToolTip="1曲ループ" AutomationProperties.Name="1曲ループ" Click="TrackLoop_Click" Background="Transparent" Padding="8,7" FontSize="11"/></StackPanel><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock x:Name="Elapsed" Text="0:00" FontSize="11" Foreground="#9FAEAA"/><Slider x:Name="Seek" IsMoveToPointEnabled="True" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="Seek_Changed" AutomationProperties.Name="再生位置"/><TextBlock x:Name="Duration" Grid.Column="2" Text="0:00" FontSize="11" HorizontalAlignment="Right" Foreground="#9FAEAA"/></Grid></StackPanel>
    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0,0,0"><TextBlock Text="音量" Foreground="#9FAEAA" FontSize="11"/><Slider x:Name="Volume" Minimum="0" Maximum="100" Value="70" ValueChanged="Volume_Changed" Margin="0,9,0,0" AutomationProperties.Name="音量"/><Button x:Name="QueueButton" Content="キューを開く  ≡" Click="Queue_Click" Background="Transparent" Padding="0,8,0,0" FontSize="11"/></StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>




